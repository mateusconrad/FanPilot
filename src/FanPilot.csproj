<Project Sdk="Microsoft.NET.Sdk">

  <!-- Two builds of the same FanPilot (item 28). Windows: the .NET Framework 4.7.2 that ships with it, because the
       Gigabyte service's IPC (.NET Remoting) only exists there. Linux: .NET 10, published self-contained. The .NET SDK
       is only needed to build. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <AssemblyName>FanPilot</AssemblyName>
    <RootNamespace />
    <ApplicationIcon>..\assets\brand\fanpilot.ico</ApplicationIcon>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
    <ApplicationManifest>..\app.manifest</ApplicationManifest>
    <!-- LibreHardwareMonitor's dependencies were built against slightly different versions of each other. -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <!-- bin\FanPilot.exe (Release) and bin\Debug\FanPilot.exe, where the README, the scripts and the end-to-end tests
         find it; the Linux build goes to a net10.0 folder inside each. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- The Linux build is published as a single file (item 28): its analyzer runs on every build, so what breaks in one
       file shows up early, and the package it needs is always in the lock file, published or not. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <!-- Release goes to bin\ next to data\, as the README describes; build.ps1 -OutDir builds elsewhere. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputPath>..\bin\</OutputPath>
  </PropertyGroup>

  <!-- No reference to Gigabyte Control Center: GigabyteApi loads its client DLLs at runtime from the GCC install,
       so one build (on any machine, the CI included) serves Gigabyte and every other board. -->
  <ItemGroup>
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
    <InternalsVisibleTo Include="FanPilot.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <!-- The Windows service mode (item 14a). -->
    <Reference Include="System.ServiceProcess" />
    <!-- DPAPI for the alert destinations' secrets (item 16). -->
    <Reference Include="System.Security" />
    <!-- The terminal's client of the local API (item 29); .NET 10 has it built in. -->
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <!-- What only one system has. Windows: Gigabyte Control Center, LibreHardwareMonitor with PawnIO, the Windows service
       and *.Windows.cs. Linux: *.Linux.cs and the kernel's hwmon (Hwmon*.cs). Each *.Windows.cs has a *.Linux.cs with the
       same members. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="Gigabyte*.cs;Lhm*.cs;CpuTemperature.cs;PawnIoSetup.cs;FanPilotService.cs;*.Windows.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Compile Remove="*.Linux.cs;Hwmon*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\wwwroot\**" LinkBase="wwwroot" CopyToOutputDirectory="PreserveNewest" />
    <!-- The panel's dictionaries are also the exe's (I18n.cs): inside it, so the console and the reports never miss them. -->
    <EmbeddedResource Include="..\wwwroot\i18n\*.json" LogicalName="i18n.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- MSBuild only redirects the version conflicts it sees at build time. Gigabyte's assemblies are loaded at runtime
       from the GCC folder and could reference older versions of the libraries FanPilot ships, so every strong-named
       library next to the exe gets a redirect to its own copy (what NuGet did in packages.config projects). -->
  <Target Name="RedirectEveryShippedLibrary" AfterTargets="ResolveAssemblyReferences" BeforeTargets="GenerateBindingRedirects" Condition="'$(TargetFramework)' == 'net472'">
    <ItemGroup>
      <_StrongNamedShipped Include="@(ReferencePath)" Condition="'%(ReferencePath.FusionName)' != '' and !$([System.String]::Copy('%(ReferencePath.FusionName)').Contains('PublicKeyToken=null'))" />
      <!-- Only what is copied next to the exe (System.Management, for instance, comes from Windows itself). -->
      <_NotShipped Include="@(_StrongNamedShipped)" />
      <_NotShipped Remove="@(ReferenceCopyLocalPaths)" MatchOnMetadata="Filename" />
      <_StrongNamedShipped Remove="@(_NotShipped)" />
      <SuggestedBindingRedirects Include="$([System.Text.RegularExpressions.Regex]::Replace('%(_StrongNamedShipped.FusionName)', 'Version=[^,]*, ', ''))" MaxVersion="$([System.Text.RegularExpressions.Regex]::Replace('%(_StrongNamedShipped.FusionName)', '^.*Version=([^,]*),.*$', '$1'))" />
    </ItemGroup>
  </Target>

</Project>
