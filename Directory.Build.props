<Project>
  <!-- Shared by src\FanPilot.csproj and the test projects. -->
  <PropertyGroup>
    <!-- The version, in one place: FanPilot.exe's version option, the log, the diagnose report, /api/info, the panel
         and the release zip show it (with the commit, e.g. 0.1.0+1a2b3c4), and a release tag must match it
         (.github/workflows/release.yml). -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <LangVersion>latest</LangVersion>
    <!-- FanPilot only runs on 64-bit Windows; the LibreHardwareMonitor package ships its assembly per runtime. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <!-- packages.lock.json pins every NuGet package and its hash; CI (CI=true) refuses anything that differs. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>
  <ItemGroup>
    <!-- The .NET Framework reference assemblies come from NuGet on every machine. The SDK only adds this package
         where the targeting pack is missing (a PC without Visual Studio) and not where it is installed (the CI
         runner), so packages.lock.json differed between the two and the CI's locked restore failed. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
