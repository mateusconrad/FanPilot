<Project Sdk="Microsoft.NET.Sdk">

  <!-- The same two builds as FanPilot (item 28): net472 runs on Windows, net10.0 on Linux (the CI's ubuntu job, or a
       container). On Windows, dotnet test leaves net10.0 out: it would run the Linux code on Windows. -->
  <PropertyGroup>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <!-- Bring FanPilot.exe.config along with FanPilot.exe: the smoke tests check its binding redirects. -->
    <AllowedReferenceRelatedFileExtensions>$(AllowedReferenceRelatedFileExtensions);.exe.config</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0' and '$(OS)' == 'Windows_NT'">
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <!-- Tests that need Administrator report as skipped (not passed) when run without it. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FanPilot.csproj" />
  </ItemGroup>

  <!-- JsonTests checks FanPilot's Json against the JavaScriptSerializer it replaced (item 28). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <!-- TrayStatusTests reads what the tray icon (item 14b) makes of /api/state: the tray is Windows only, this file is not. -->
  <ItemGroup>
    <Compile Include="..\..\tray\TrayStatus.cs" Link="tray\TrayStatus.cs" />
  </ItemGroup>

  <!-- Tests of what only one system has, as in src\FanPilot.csproj. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="Gcc*.cs;Gigabyte*.cs;CpuTemperatureTests.cs;*.Windows.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Compile Remove="*.Linux.cs;Hwmon*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- No shadow copy: tests read the files next to FanPilot.exe (its .config, the shipped libraries). -->
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Shared with tests/js: the panel and the backend must compute curves the same way. -->
    <None Include="..\fixtures\**" LinkBase="fixtures" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
